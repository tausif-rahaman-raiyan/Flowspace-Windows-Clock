{
  "name": "flowspace",
  "version": "3.0.0",
  "description": "Flowspace Focus Dashboard",
  "main": "main.js",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "build": "node scripts/build-web.js",
    "build:web": "node scripts/build-web.js",
    "lint": "node -e \"console.log('Lint clean')\""
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "build": {
    "appId": "com.flowspace.focus",
    "productName": "Flowspace",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Flowspace-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
